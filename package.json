{
  "name": "hermes-claude-bridge",
  "version": "0.2.0",
  "description": "Use Claude models from Hermes through the Claude Agent SDK and Claude subscription OAuth.",
  "keywords": [
    "hermes",
    "hermes-agent",
    "claude",
    "claude-code",
    "claude-agent-sdk",
    "openai-compatible",
    "model-provider"
  ],
  "author": "Rico Trevisan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricotrevisan/hermes-claude-bridge.git"
  },
  "homepage": "https://github.com/ricotrevisan/hermes-claude-bridge#readme",
  "bugs": {
    "url": "https://github.com/ricotrevisan/hermes-claude-bridge/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "hermes-claude-bridge": "bin/cli.mjs"
  },
  "files": [
    "dist/",
    "bin/",
    "plugin/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "dev": "node --import tsx src/server.ts",
    "test": "node --import tsx --test src/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.141",
    "cc-session-io": "^0.3.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
